@{
	ViewData["Title"] = "Загрузить файл";
	var groupId = ViewBag.GroupId as int?;
}

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card">
				<div class="card-header">
					<h4 class="mb-0">Загрузка файла</h4>
				</div>
				<div class="card-body">
					<form asp-action="Upload" method="post" enctype="multipart/form-data">
						<input type="hidden" name="groupId" value="@groupId" />
						<div class="form-group mb-3">
							<label for="file" class="form-label">Выберите файл</label>
							<input type="file" name="file" id="file" class="form-control" required />
						</div>
						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
						<div class="form-group">
							<button type="submit" class="btn btn-primary">Загрузить</button>
							<a asp-action="Index" asp-route-groupId="@groupId" class="btn btn-secondary ms-2">Отмена</a>
						</div>
						</form>
				</div>
			</div>
		</div>
	</div>
</div>

