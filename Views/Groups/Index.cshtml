@model IEnumerable<Diplom_StudyHub.Models.ViewModels.GroupListViewModel>
@using Diplom_StudyHub.Models.Enums

@{
    ViewData["Title"] = "Группы";
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
}

<div class="container main-content mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Группы</h1>
            <p class="text-muted">Учебные группы и сообщества</p>
        </div>
        <div class="col text-end">
            <a asp-action="Create" class="btn btn-primary btn-lg">Создать группу</a>
        </div>
    </div>

    <!-- Поиск и фильтры -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="searchQuery" class="form-control"
                           placeholder="Поиск по названию или описанию..." value="@searchQuery" />
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">Все группы</option>
                        <option value="Open" selected="@(statusFilter == "Open")">Открытые</option>
                        <option value="Closed" selected="@(statusFilter == "Closed")">Закрытые</option>
                        <option value="Archived" selected="@(statusFilter == "Archived")">Архив</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Найти</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <h3 class="text-muted mb-3">Группы не найдены</h3>
                <p class="text-muted mb-4">
                    @(string.IsNullOrEmpty(searchQuery) ? "Создайте первую группу!" : "Попробуйте изменить параметры поиска")
                </p>
                @if (string.IsNullOrEmpty(searchQuery))
                {
                    <a asp-action="Create" class="btn btn-primary btn-lg">Создать группу</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card group-card h-100">
                        <a asp-action="Details" asp-route-id="@item.Id" class="group-card-link text-decoration-none">
                            @if (!string.IsNullOrEmpty(item.AvatarUrl))
                            {
                                <img src="@item.AvatarUrl" alt="@item.Name" class="card-img-top" style="height: 160px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="card-img-top bg-gradient d-flex align-items-center justify-content-center" style="height: 160px;">
                                    <h2 class="text-white mb-0">@item.Name.Substring(0, Math.Min(2, item.Name.Length)).ToUpper()</h2>
                                </div>
                            }
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">@item.Name</h5>
                                    @if (item.Status == GroupStatus.Open)
                                    {
                                        <span class="badge bg-success">Открытая</span>
                                    }
                                    else if (item.Status == GroupStatus.Closed)
                                    {
                                        <span class="badge bg-warning">Закрытая</span>
                                    }
                                    else if (item.Status == GroupStatus.Archived)
                                    {
                                        <span class="badge bg-secondary">Архив</span>
                                    }
                                </div>
                                <p class="card-text text-muted small">
                                    @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description ?? "Описание отсутствует")
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted">@item.OwnerName</small>
                                    <small class="text-muted">@item.CreatedAt.ToString("dd.MM.yyyy")</small>
                                </div>
                            </div>
                        </a>

                        <div class="card-footer">
                            <div class="d-flex gap-2 flex-wrap">
                                @if (item.IsOwner)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Изменить</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                                }
                                else if (item.IsMember)
                                {
                                    <a asp-action="Leave" asp-route-id="@item.Id"
                                       class="btn btn-secondary btn-sm"
                                       onclick="return confirm('Покинуть группу?')">Покинуть</a>
                                }
                                else if (item.Status == GroupStatus.Open)
                                {
                                    <a asp-action="Join" asp-route-id="@item.Id" class="btn btn-success btn-sm">Вступить</a>
                                }
                                else if (item.Status == GroupStatus.Closed)
                                {
                                    <a asp-action="JoinByCode" asp-route-id="@item.Id" class="btn btn-warning btn-sm">По коду</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.Pagination != null)
        {
            @await Html.PartialAsync("_Pagination", (Diplom_StudyHub.Models.ViewModels.PaginationViewModel)ViewBag.Pagination)
        }
    }
</div>