@model Diplom_StudyHub.Models.ViewModels.GroupDetailsViewModel

@{
    ViewData["Title"] = "Группа: " + Model.Name;
}

<h1>@Model.Name</h1>

<div class="card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <div class="text-center mb-3">
                <img src="@Model.AvatarUrl" alt="Аватар группы" class="img-thumbnail" style="max-width: 200px;" />
            </div>
        }

        <div class="row">
            <div class="col-md-6">
                <h5>Описание</h5>
                <p>@(Model.Description ?? "Описание отсутствует")</p>
            </div>

            <div class="col-md-6">
                <h5>Информация</h5>
                <ul class="list-unstyled">
                    <li><strong>Владелец:</strong> @Model.OwnerName</li>
                    <li><strong>Создана:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</li>
                    <li><strong>Участников:</strong> @Model.MemberCount</li>
                    <li>
                        <strong>Статус:</strong>
                        @if (Model.Status == Diplom_StudyHub.Models.Enums.GroupStatus.Open)
                        {
                            <span class="badge badge-status-open">Открытая</span>
                        }
                        else if (Model.Status == Diplom_StudyHub.Models.Enums.GroupStatus.Closed)
                        {
                            <span class="badge badge-status-closed">Закрытая</span>
                        }
                        else if (Model.Status == Diplom_StudyHub.Models.Enums.GroupStatus.Archived)
                        {
                            <span class="badge badge-status-archived">Архив</span>
                        }
                        else
                        {
                            <span class="badge badge-status-blocked">Заблокирована</span>
                        }
                    </li>
                </ul>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.InviteCode))
        {
            <div class="alert alert-info mt-3">
                <strong>Код приглашения:</strong>
                <code>@Model.InviteCode</code>
                <button class="btn btn-sm btn-outline-primary ms-2" onclick="navigator.clipboard.writeText('@Model.InviteCode')">Копировать</button>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Join" asp-controller="GroupMembers" class="btn btn-success">Вступить в группу</a>
            <a asp-action="Index" asp-controller="GroupMembers" asp-route-groupId="@Model.Id" class="btn btn-info">Участники (@Model.MemberCount)</a>
            <a asp-action="Index" asp-controller="Messages" asp-route-groupId="@Model.Id" class="btn btn-primary">Чат</a>
            <a asp-action="Index" asp-controller="Documents" asp-route-groupId="@Model.Id" class="btn btn-warning">Файлы</a>
            <a asp-action="Index" asp-controller="Lessons" asp-route-groupId="@Model.Id" class="btn btn-success">Уроки</a>
            <a asp-action="Index" asp-controller="Meet" asp-route-groupId="@Model.Id" class="btn btn-danger">Видеозвонок</a>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (Model.IsOwner)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактировать</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Удалить</a>
    }
    <a asp-action="Index" asp-controller="Groups" class="btn btn-secondary">Назад к списку</a>
</div>