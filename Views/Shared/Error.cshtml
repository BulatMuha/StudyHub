@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="text-danger">Ошибка</h1>
<h2 class="text-danger">Произошла ошибка при обработке вашего запроса.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID запроса:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим разработки</h3>
<p>
    Переключение на среду <strong>Разработка</strong> отобразит более подробную информацию об ошибке.
</p>
<p>
    <strong>Среда разработки не должна быть включена для работающих приложений.</strong>
    Это может привести к отображению конфиденциальной информации об исключениях для конечных пользователей.
    Для локальной отладки включите среду <strong>Разработка</strong>, установив переменную окружения <strong>ASPNETCORE_ENVIRONMENT</strong> в значение <strong>Development</strong>
    и перезапустив приложение.
</p>    