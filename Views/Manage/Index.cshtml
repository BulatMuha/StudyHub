@{
    ViewData["Title"] = "Настройки профиля";
}

<h1>Профиль</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3">
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                Личные данные
            </div>
            <div class="card-body">
                <form asp-controller="Manage" asp-action="UpdateProfile" method="post">

                    <div class="form-group mb-3">
                        <label class="form-label">Имя</label>
                        <input type="text" name="firstName" class="form-control"
                               value="@ViewBag.FirstName" placeholder="Иван" maxlength="50" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Фамилия</label>
                        <input type="text" name="lastName" class="form-control"
                               value="@ViewBag.LastName" placeholder="Иванов" maxlength="50" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@ViewBag.Email" disabled
                               style="background-color: var(--bg-primary) !important; color: var(--text-secondary) !important;" />
                        <small class="form-text text-muted">Email нельзя изменить</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Телефон</label>
                        <input type="tel" name="phoneNumber" class="form-control"
                               value="@ViewBag.PhoneNumber" placeholder="+79991234567" />
                        <small class="form-text text-muted">Для входа</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Дата рождения</label>
                        <input type="date" name="dateOfBirth" class="form-control"
                               value="@ViewBag.DateOfBirth"
                               max="@DateTime.Today.AddYears(-10).ToString("yyyy-MM-dd")" />
                        <small class="form-text text-muted">Минимум 10 лет</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Пол</label>
                        <select name="gender" class="form-control">
                            <option value="">Не указан</option>
                            <option value="1" selected="@(ViewBag.Gender?.ToString() == "Male")">Мужской</option>
                            <option value="2" selected="@(ViewBag.Gender?.ToString() == "Female")">Женский</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary mt-2">
                        Сохранить изменения
                    </button>
                </form>

                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-secondary mt-2">
                    Сменить пароль
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                Настройки интерфейса
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Тема оформления</label>
                    <select id="themeSelector" class="form-control">
                        <option value="base" selected>Base (Зелёная)</option>
                        <option value="dark">Dark (Синяя)</option>
                        <option value="light">Light (Светлая)</option>
                    </select>
                    <small class="form-text">Выберите тему интерфейса</small>
                </div>

                <div class="form-group mt-3">
                    <label class="form-label">Язык интерфейса</label>
                    <select class="form-control">
                        <option value="ru" selected>Русский</option>
                        <option value="en">English</option>
                    </select>
                    <small class="form-text">Скоро будет доступно</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        Статистика
    </div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-md-4">
                <h3 class="text-accent">@ViewBag.GroupCount</h3>
                <p class="text-muted">Групп</p>
            </div>
            <div class="col-md-4">
                <h3 class="text-accent">@ViewBag.LessonCount</h3>
                <p class="text-muted">Уроков</p>
            </div>
            <div class="col-md-4">
                <h3 class="text-accent">@ViewBag.MessageCount</h3>
                <p class="text-muted">Сообщений</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const savedTheme = localStorage.getItem('studyhub-theme') || 'base';
            const themeSelector = document.getElementById('themeSelector');
            if (themeSelector) {
                themeSelector.value = savedTheme;

                themeSelector.addEventListener('change', function(e) {
                    const newTheme = e.target.value;
                    localStorage.setItem('studyhub-theme', newTheme);
                    document.documentElement.setAttribute('data-theme', newTheme);
                    if (typeof showNotification === 'function') {
                        showNotification('success', 'Тема применена');
                    }
                });
            }
        });
    </script>
}