@model IEnumerable<Diplom_StudyHub.Models.ViewModels.GroupMemberViewModel>
@{
    ViewData["Title"] = "Участники группы";
    var groupId = ViewBag.GroupId as int?;
    var isOwner = ViewBag.IsOwner as bool? ?? false;
}

<div class="container main-content mt-4">
    <div class="row mb-3">
        <div class="col">
            <h1>Участники группы</h1>
        </div>
        <div class="col text-end">
            <a asp-action="Details" asp-controller="Groups" asp-route-id="@groupId" class="btn btn-secondary">Назад к группе</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Пользователь</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Вступил</th>
                        @if (isOwner)
                        {
                            <th>Действия</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(member.LastName) && !string.IsNullOrEmpty(member.FirstName))
                                {
                                    <strong>@member.LastName @member.FirstName</strong>
                                }
                                else
                                {
                                    @member.UserName
                                }
                            </td>
                            <td class="text-muted">@member.Email</td>
                            <td>
                                @if (isOwner && member.Role != Diplom_StudyHub.Models.Enums.GroupMemberRole.Owner)
                                {
                                    <form asp-action="ChangeRole" method="post" class="d-inline">
                                        <input type="hidden" name="groupId" value="@groupId" />
                                        <input type="hidden" name="userId" value="@member.UserId" />
                                        <select name="newRole" class="form-select form-select-sm d-inline" style="width: auto">
                                            <option value="Member" selected="@(member.Role == Diplom_StudyHub.Models.Enums.GroupMemberRole.Member)">Участник</option>
                                            <option value="Moderator" selected="@(member.Role == Diplom_StudyHub.Models.Enums.GroupMemberRole.Moderator)">Модератор</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary ms-2">OK</button>
                                    </form>
                                }
                                else
                                {
                                    @(member.Role == Diplom_StudyHub.Models.Enums.GroupMemberRole.Owner ? "Владелец" :
                                                                member.Role == Diplom_StudyHub.Models.Enums.GroupMemberRole.Moderator ? "Модератор" : "Участник")
                                                        }
                            </td>
                            <td>@member.JoinedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            @if (isOwner)
                            {
                                <td>
                                    @if (member.Role != Diplom_StudyHub.Models.Enums.GroupMemberRole.Owner)
                                    {
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="groupId" value="@groupId" />
                                            <input type="hidden" name="userId" value="@member.UserId" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить участника?')">Удалить</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Владелец</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>