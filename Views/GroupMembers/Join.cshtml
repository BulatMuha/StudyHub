@{
    ViewData["Title"] = "Вступить по коду";
    var groupId = ViewBag.GroupId as int?;
    var groupName = ViewBag.GroupName as string;
}

<h1>Вступление в группу</h1>

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Группа: @groupName</h5>
        <p class="card-text">Введите код приглашения для вступления в закрытую группу.</p>

        <form asp-controller="GroupMembers" asp-action="JoinWithCode" method="post">
            <input type="hidden" name="groupId" value="@groupId" />

            <div class="form-group mb-3">
                <label class="form-label">Код приглашения</label>
                <input type="text" name="inviteCode" class="form-control"
                       placeholder="Введите 8-значный код" maxlength="8" required />
            </div>

            <button type="submit" class="btn btn-primary">Вступить</button>
            <a asp-controller="Groups" asp-action="Details" asp-route-id="@groupId" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>