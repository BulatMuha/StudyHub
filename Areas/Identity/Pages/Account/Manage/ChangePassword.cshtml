@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Сменить пароль";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="container main-content mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Настройки аккаунта</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="list-group list-group-flush">
                    <a asp-page="./Index" class="list-group-item list-group-item-action @(ViewData["ActivePage"]?.ToString() == "Index" ? "active" : "")">
                        Профиль
                    </a>
                    <a asp-page="./ChangePassword" class="list-group-item list-group-item-action @(ViewData["ActivePage"]?.ToString() == "ChangePassword" ? "active" : "")">
                        Пароль
                    </a>
                    <a asp-page="./PersonalData" class="list-group-item list-group-item-action @(ViewData["ActivePage"]?.ToString() == "PersonalData" ? "active" : "")">
                        Личные данные
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Смена пароля</h5>
                </div>
                <div class="card-body">
                    <form id="change-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Input.OldPassword" class="form-label">Текущий пароль</label>
                            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword" class="form-label">Новый пароль</label>
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Минимум 8 символов, хотя бы одна цифра, заглавная и строчная буква
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Подтвердите новый пароль</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Сменить пароль
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}