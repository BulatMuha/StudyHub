@page
@model LoginModel
@using Diplom_StudyHub.Models

@{
    ViewData["Title"] = "Вход";
}

<h1>Вход</h1>

<div class="card mt-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mx-auto">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">
                            Запомнить меня
                        </label>
                    </div>

                    <div class="form-group">
                        <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg">
                            Войти
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Зарегистрироваться</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.ExternalLogins?.Count > 0)
{
    <div class="card mt-4">
        <div class="card-body">
            <h3 class="card-title">Войти через другой сервис</h3>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div>
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-secondary me-2" name="provider" value="@provider.Name">
                            @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}