@page
@model RegisterModel
@using Diplom_StudyHub.Models
@using Diplom_StudyHub.Models.Enums

@{
    ViewData["Title"] = "Регистрация";
}

<h1>Регистрация</h1>

<div class="card mt-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <!-- Имя и Фамилия -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Input.FirstName" class="form-label">Имя *</label>
                                <input asp-for="Input.FirstName" class="form-control" aria-required="true" placeholder="Иван" />
                                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Input.LastName" class="form-label">Фамилия *</label>
                                <input asp-for="Input.LastName" class="form-control" aria-required="true" placeholder="Иванов" />
                                <span asp-validation-for="Input.LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label">Email *</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Дата рождения и Пол -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Input.DateOfBirth" class="form-label">Дата рождения</label>
                                <input asp-for="Input.DateOfBirth" type="date" class="form-control"
                                       max="@DateTime.Today.AddYears(-10).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                                <small class="form-text text-muted">Минимум 10 лет</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Input.Gender" class="form-label">Пол</label>
                                <select asp-for="Input.Gender" class="form-control">
                                    <option value="">Не указан</option>
                                    <option value="1">Мужской</option>
                                    <option value="2">Женский</option>
                                </select>
                                <span asp-validation-for="Input.Gender" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Пароль -->
                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль *</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <small class="form-text">Минимум 8 символов, хотя бы одна цифра, заглавная и строчная буква</small>
                    </div>

                    <!-- Подтверждение пароля -->
                    <div class="form-group mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Подтвердите пароль *</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg">
                            Зарегистрироваться
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <p>
                            Уже есть аккаунт? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Войти</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.ExternalLogins?.Count > 0)
{
    <div class="card mt-4">
        <div class="card-body">
            <h3 class="card-title">Зарегистрироваться через другой сервис</h3>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div>
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-secondary me-2" name="provider" value="@provider.Name">
                            @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}